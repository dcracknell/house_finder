# Copy to .env and fill in. Never commit .env.

# --- Required for LLM ranking (pass 2). Without it the pipeline still runs
# --- using the free keyword pre-score only.
ANTHROPIC_API_KEY=

# --- Optional enrichment ---
# EPC Register (free, self-service key): https://epc.opendatacommunities.org/
EPC_API_EMAIL=
EPC_API_KEY=

# Ofcom broadband/mobile coverage (free developer registration): https://api.ofcom.org.uk/
OFCOM_API_KEY=

# PropertyData (PAID — analytics/comparables only, no listings search).
# Leave blank to keep it disabled; sources.yaml auto-enables it when set.
PROPERTYDATA_API_KEY=

# --- Optional email digest ---
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
